cingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="344" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_experience_years" value="experience_years &lt;font color=&quot;#888888&quot;&gt;tinyint(4)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="368" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_avatar" value="avatar &lt;font color=&quot;#888888&quot;&gt;varchar(255)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="392" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_birth_date" value="birth_date &lt;font color=&quot;#888888&quot;&gt;date&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="416" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_gender" value="gender &lt;font color=&quot;#888888&quot;&gt;enum(…)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="440" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_experience_note" value="experience_note &lt;font color=&quot;#888888&quot;&gt;text&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="464" width="270" height="24" as="geometry"/></mxCell><mxCell id="c_tutors_expected_fee" value="expected_fee &lt;font color=&quot;#888888&quot;&gt;decimal(10,2)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;" vertex="1" parent="t_tutors"><mxGeometry y="488" width="270" height="24" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;ERD – CSDL vietedu (Trung tâm gia sư VietEdu)&lt;/b&gt;&lt;br&gt;• 12 bảng, 10 khóa ngoại. Ký hiệu chân gà: ‖ = phía 1, chân gà = phía nhiều (n), ○ = có thể không có.&lt;br&gt;• &lt;b&gt;PK&lt;/b&gt; khóa chính, &lt;b&gt;FK&lt;/b&gt; khóa ngoại.&lt;br&gt;• tutors – classes là quan hệ &lt;b&gt;n – n&lt;/b&gt;, tách qua bảng trung gian &lt;b&gt;class_matching&lt;/b&gt;.&lt;br&gt;• Nét đứt: classes.assigned_tutor_id → tutors (liên kết logic, không đặt ràng buộc FK).&lt;br&gt;• support_tickets.sender_id trỏ tới parents hoặc tutors tùy sender_type; password_resets, login_attempts là bảng độc lập." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=#FFFBEA;strokeColor=#D6B656;spacing=10;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1400" y="440" width="300" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>